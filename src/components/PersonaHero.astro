---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  heading: string;
  subhead: string;
  anchorId: string;
  anchorLabel: string;
}

const { image, imageAlt, heading, subhead, anchorId, anchorLabel } = Astro.props;
---

<section class="d-flex align-items-end text-white position-relative" style="min-height: 70vh;">
  <Image
    src={image}
    alt={imageAlt}
    class="position-absolute top-0 start-0 w-100 h-100"
    style="object-fit: cover;"
    width={1600}
    loading="eager"
  />
  <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-25"></div>
  <div class="container position-relative py-5">
    <h1 class="display-5">{heading}</h1>
    <p class="fs-5 col-lg-8">{subhead}</p>
    <div class="d-flex gap-3 flex-wrap">
      <a class="btn btn-primary btn-lg" href="/drive/#pricing">See storage plans</a>
      <a class="btn btn-outline-light btn-lg" href={`#${anchorId}`}>{anchorLabel}</a>
    </div>
  </div>
</section>
