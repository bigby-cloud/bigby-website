---
interface Item {
  heading: string;
  body: string;
}

interface Props {
  heading: string;
  subhead?: string;
  items: Item[];
  anchorId?: string;
  bgClass?: string;
  colClass?: string;
}

const { heading, subhead, items, anchorId, bgClass = '', colClass = 'col-md-6 col-lg-3' } = Astro.props;
---

<section class:list={["py-5", bgClass]} id={anchorId}>
  <div class="container">
    <h2>{heading}</h2>
    {subhead && <p class="fs-5 col-lg-8 text-body-secondary">{subhead}</p>}
    <div class="row g-4 mt-2">
      {
        items.map((item) => (
          <div class={colClass}>
            <h3 class="h5">{item.heading}</h3>
            <p>{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
