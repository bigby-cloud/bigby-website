---
import JsonLd from './JsonLd.astro';

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  heading?: string;
  faqs: Faq[];
  idPrefix?: string;
}

const { heading = 'Frequently asked questions', faqs, idPrefix = 'faq' } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<section class="py-5">
  <div class="container">
    <h2 class="mb-4">{heading}</h2>
    <div class="accordion" id={`${idPrefix}-accordion`}>
      {
        faqs.map((faq, i) => (
          <div class="accordion-item">
            <h3 class="accordion-header" id={`${idPrefix}-heading-${i}`}>
              <button
                class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target={`#${idPrefix}-collapse-${i}`}
                aria-expanded="false"
                aria-controls={`${idPrefix}-collapse-${i}`}
              >
                {faq.question}
              </button>
            </h3>
            <div
              id={`${idPrefix}-collapse-${i}`}
              class="accordion-collapse collapse"
              aria-labelledby={`${idPrefix}-heading-${i}`}
              data-bs-parent={`#${idPrefix}-accordion`}
            >
              <div class="accordion-body">{faq.answer}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <JsonLd data={faqSchema} />
</section>
