---
interface Props {
  heading: string;
  subhead: string;
}

const { heading, subhead } = Astro.props;
---

<section class="py-5 bg-body-tertiary text-center">
  <div class="container">
    <h2>{heading}</h2>
    <p class="fs-5 col-lg-8 mx-auto text-body-secondary">{subhead}</p>
    <a class="btn btn-primary btn-lg mt-3" href="/drive/#pricing">See all plans</a>
    <p class="small text-body-secondary mt-3 mb-0">
      Annual or monthly billing &middot; All prices in GBP &middot; UK data residency &middot; GDPR compliant
    </p>
  </div>
</section>
