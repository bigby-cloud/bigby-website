---
import { getEntry } from 'astro:content';
import PersonaTemplate from '../layouts/PersonaTemplate.astro';

const entry = await getEntry('personas', 'expats');
---

<PersonaTemplate title="Secure, UK Cloud Storage for Expats | Bigby.cloud" description='Living abroad but want your files under UK law? Bigby keeps your data on UK servers with UK GDPR protection, wherever you are in the world.' persona={entry.data} />
